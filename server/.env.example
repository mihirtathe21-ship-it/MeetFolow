# --- Email (Nodemailer) ---
# Leave these blank in dev and the server will auto-create a free Ethereal test
# inbox at startup and log the preview-message URL to the console instead of
# actually sending mail. Fill these in with real SMTP creds for production
# (e.g. Gmail app password, SendGrid, Mailgun, SES).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=MeetFlow <no-reply@meetflow.app>

# --- AI meeting summary (optional) ---
# Any OpenAI-compatible endpoint works (OpenAI, or Gemini/OpenRouter via their
# OpenAI-compatible base URL). Leave blank to disable the "Summarize" button.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
